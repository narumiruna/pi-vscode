{
  "name": "narumi-pi",
  "displayName": "Pi",
  "description": "Use Pi in VS Code to understand code and apply focused modifications.",
  "version": "0.8.1",
  "private": true,
  "publisher": "narumi",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-vscode"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Testing"
  ],
  "keywords": [
    "pi",
    "coding agent",
    "ai",
    "code review",
    "refactor",
    "autocomplete",
    "inline completion",
    "agent",
    "chat",
    "ai assistant",
    "code generation",
    "code editing",
    "inline edit",
    "next edit",
    "test generation",
    "test repair",
    "diagnostics",
    "quick fix",
    "code explanation",
    "documentation",
    "git review",
    "worktree"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "pi",
          "title": "Pi",
          "icon": "resources/pi.svg"
        }
      ]
    },
    "views": {
      "pi": [
        {
          "id": "pi.chatView",
          "name": "Sessions",
          "type": "webview",
          "icon": "resources/pi.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "pi.extensionDialog.allow",
        "title": "Allow Reviewed Extension Action",
        "category": "Pi",
        "icon": "$(check)",
        "enablement": "isWorkspaceTrusted && pi.extensionConfirmationActive"
      },
      {
        "command": "pi.extensionDialog.block",
        "title": "Block Reviewed Extension Action",
        "category": "Pi",
        "icon": "$(close)",
        "enablement": "isWorkspaceTrusted && pi.extensionConfirmationActive"
      },
      {
        "command": "pi.extensionEditor.submit",
        "title": "Submit Extension Editor",
        "category": "Pi",
        "icon": "$(check)",
        "enablement": "isWorkspaceTrusted && pi.extensionEditorActive"
      },
      {
        "command": "pi.extensionEditor.cancel",
        "title": "Cancel Extension Editor",
        "category": "Pi",
        "icon": "$(close)",
        "enablement": "isWorkspaceTrusted && pi.extensionEditorActive"
      },
      {
        "command": "pi.reloadResources",
        "title": "Reload Pi Resources",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.signInProvider",
        "title": "Sign In to Provider",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.openNativeSettings",
        "title": "Open Native Pi Settings",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.signOutProvider",
        "title": "Sign Out of Provider",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.restartResources",
        "title": "Restart Pi (Current Launch Policy)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.exportSession",
        "title": "Export Session",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.openNativeMcp",
        "title": "Manage Native MCP Configuration",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.importSession",
        "title": "Import Session Copy",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.browseSessionTree",
        "title": "Browse Session Tree / Fork / Clone",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.shareSession",
        "title": "Share Session",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.nativeRuntimeControls",
        "title": "Native Runtime Controls (Global Save)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.returnFromTerminal",
        "title": "Return Pi from Terminal / Recover Ownership",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.applyNativeConfiguration",
        "title": "Apply Saved Native Configuration (Reload Resources)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.extensionUiCompatibility",
        "title": "Extension UI Compatibility",
        "category": "Pi"
      },
      {
        "command": "pi.openSettings",
        "title": "Open Settings",
        "category": "Pi",
        "icon": "$(gear)"
      },
      {
        "command": "pi.reviewChanges",
        "title": "Review Changes",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.showReviewFindings",
        "title": "Show Review Findings",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.fixWorkspaceDiagnostics",
        "title": "Fix Workspace Diagnostics (Preview)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.askReviewFinding",
        "title": "Ask About Review Finding",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.fixReviewFinding",
        "title": "Fix Review Finding (Preview)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.repairFailedTest",
        "title": "Repair Failed Test (Preview)",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.askDebugContext",
        "title": "Ask Debug Context",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted && debugState == stopped"
      },
      {
        "command": "pi.reviewStagedChanges",
        "title": "Review Staged Changes",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.showStagedFindings",
        "title": "Show Staged Findings",
        "category": "Pi",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "pi.openChat",
        "title": "Open Sessions",
        "category": "Pi",
        "icon": {
          "light": "resources/pi.svg",
          "dark": "resources/pi-dark.svg"
        }
      },
      {
        "command": "pi.clearAnnotations",
        "title": "Clear Annotations",
        "category": "Pi"
      },
      {
        "command": "pi.askSelection",
        "title": "Ask About Selection",
        "category": "Pi",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pi.modifySelection",
        "title": "Modify Selection (Preview)",
        "category": "Pi",
        "icon": "$(wand)"
      },
      {
        "command": "pi.inlineEdit",
        "title": "Inline Edit (Preview)",
        "category": "Pi",
        "icon": "$(edit)"
      },
      {
        "command": "pi.quickFix",
        "title": "Quick Fix with Pi (Preview)",
        "category": "Pi",
        "icon": "$(lightbulb-sparkle)"
      },
      {
        "command": "pi.explainSelection",
        "title": "Explain Selection",
        "category": "Pi",
        "icon": "$(info)"
      },
      {
        "command": "pi.fixSelection",
        "title": "Fix Selection (Preview)",
        "category": "Pi",
        "icon": "$(wrench)"
      },
      {
        "command": "pi.reviewSelection",
        "title": "Review Selection",
        "category": "Pi",
        "icon": "$(eye)"
      },
      {
        "command": "pi.documentSelection",
        "title": "Document Selection (Preview)",
        "category": "Pi",
        "icon": "$(book)"
      },
      {
        "command": "pi.generateTests",
        "title": "Generate Tests (Preview)",
        "category": "Pi",
        "icon": "$(beaker)"
      },
      {
        "command": "pi.triggerInlineCompletion",
        "title": "Trigger Inline Completion",
        "category": "Pi",
        "icon": "$(sparkle)"
      },
      {
        "command": "pi.suggestNextEdit",
        "title": "Suggest Next Edit (Preview)",
        "category": "Pi",
        "icon": "$(lightbulb-sparkle)"
      }
    ],
    "chatParticipants": [
      {
        "id": "pi.chat",
        "name": "pi",
        "fullName": "Pi",
        "description": "Ask Pi about code and programming tasks using your local Pi configuration.",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain code or a programming concept"
          },
          {
            "name": "review",
            "description": "Review code for bugs and improvements"
          },
          {
            "name": "fix",
            "description": "Suggest a fix for a problem"
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "pi.selectionMenu",
        "label": "Pi"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "pi.openSettings",
          "when": "view == pi.chatView",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "pi.askReviewFinding",
          "when": "false"
        },
        {
          "command": "pi.fixReviewFinding",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "pi.extensionDialog.allow",
          "group": "navigation@1",
          "when": "pi.extensionConfirmationActive"
        },
        {
          "command": "pi.extensionDialog.block",
          "group": "navigation@2",
          "when": "pi.extensionConfirmationActive"
        },
        {
          "command": "pi.extensionEditor.submit",
          "group": "navigation@1",
          "when": "pi.extensionEditorActive"
        },
        {
          "command": "pi.extensionEditor.cancel",
          "group": "navigation@2",
          "when": "pi.extensionEditorActive"
        },
        {
          "command": "pi.quickFix",
          "group": "navigation@40",
          "when": "!editorReadonly"
        },
        {
          "command": "pi.openChat",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "pi.quickFix",
          "group": "1_modification@40",
          "when": "!editorReadonly"
        },
        {
          "submenu": "pi.selectionMenu",
          "group": "1_modification@50",
          "when": "editorHasSelection"
        }
      ],
      "pi.selectionMenu": [
        {
          "command": "pi.askSelection",
          "group": "1_query@10"
        },
        {
          "command": "pi.modifySelection",
          "group": "1_query@20"
        },
        {
          "command": "pi.explainSelection",
          "group": "2_actions@10"
        },
        {
          "command": "pi.fixSelection",
          "group": "2_actions@20"
        },
        {
          "command": "pi.reviewSelection",
          "group": "2_actions@30"
        },
        {
          "command": "pi.documentSelection",
          "group": "2_actions@40"
        },
        {
          "command": "pi.generateTests",
          "group": "2_actions@50"
        }
      ]
    },
    "keybindings": [
      {
        "command": "pi.extensionEditor.submit",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "editorTextFocus && isWorkspaceTrusted && pi.extensionEditorActive"
      },
      {
        "command": "pi.extensionEditor.cancel",
        "key": "ctrl+escape",
        "mac": "cmd+escape",
        "when": "editorTextFocus && isWorkspaceTrusted && pi.extensionEditorActive"
      },
      {
        "command": "pi.quickFix",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible"
      },
      {
        "command": "pi.triggerInlineCompletion",
        "key": "alt+]",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "pi.suggestNextEdit",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Pi",
      "properties": {
        "pi.sensitiveContextNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".env",
            "credential",
            "secret",
            "id_rsa",
            "id_ed25519"
          ],
          "description": "Best-effort warnings for attachment labels containing these names. Inspect/redact before transmission."
        },
        "pi.annotations.initialState": {
          "type": "string",
          "default": "collapsed",
          "enum": [
            "collapsed",
            "expanded"
          ],
          "description": "Initial state of new or replaced Pi annotation threads. Collapsed uses the VS Code API default; expanded opens explanations below the marked text. Does not change existing threads or shared Comments settings."
        },
        "pi.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Request automatic Pi inline completions after a typing pause. Disabled by default to avoid unexpected model usage; manual trigger remains available."
        },
        "pi.inlineCompletions.debounceMilliseconds": {
          "type": "number",
          "default": 650,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay before an automatic inline completion request."
        },
        "pi.inlineCompletions.minimumPrefixLength": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum non-whitespace characters on the current line before automatic completion."
        },
        "pi.inlineCompletions.excludedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plaintext",
            "scminput"
          ],
          "description": "Language IDs excluded from Pi inline completions."
        },
        "pi.approveProjectResources": {
          "type": "boolean",
          "default": false,
          "description": "Trust and load project-local Pi settings, extensions, skills, and prompts for RPC sessions. Enable only for workspaces you trust."
        },
        "pi.executablePath": {
          "type": "string",
          "default": "",
          "description": "Empty or whitespace uses packaged Pi 1.3.0. A nonempty executable name or path uses external Pi on the workspace Extension Host, including a saved pi command. Relative paths use the workspace launch directory. Windows external overrides support native .exe files and standard npm Node shims, not custom batch wrappers."
        },
        "pi.provider": {
          "type": "string",
          "default": "",
          "description": "Optional Pi provider override. Leave empty to use Pi settings."
        },
        "pi.model": {
          "type": "string",
          "default": "",
          "description": "Optional Pi model override. Leave empty to use Pi settings."
        },
        "pi.thinkingLevel": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Pi thinking-level override."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && tsc -p tsconfig.webview.json && node scripts/build-rich-content.mjs",
    "vscode:prepublish": "npm run compile",
    "watch": "tsc -watch -p ./",
    "test:rich-content": "npm run compile && node scripts/test-rich-content.mjs",
    "test:settings": "npm run compile && node scripts/test-settings.mjs",
    "test:thinking-picker": "npm run compile && node scripts/test-thinking-picker.mjs",
    "dev": "npm run install:extension && node scripts/open-dev-window.mjs",
    "dev:pi": "pi -ne -e resources/pi-bridge.ts",
    "install:vsix": "sh scripts/check-legacy-vscode-extension.sh && npm run package && code --install-extension pi.vsix --force",
    "install:extension": "npm run install:vsix && node scripts/remove-legacy-pi-extension.mjs",
    "test": "npm run compile && vitest run",
    "test:native": "npm run compile && node scripts/test-native.mjs",
    "test:native-ui": "npm run compile && node scripts/test-native-ui.mjs",
    "test:remote-drafts": "npm run compile && node scripts/test-remote-drafts.mjs",
    "test:screen-reader": "npm run compile && node scripts/test-screen-reader.mjs",
    "test:bundled-runtime": "node scripts/test-bundled-runtime.mjs pi.vsix",
    "package": "npm run test && vsce package --out pi.vsix && npm run test:bundled-runtime",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm version $(node -p \"require('./package.json').version\") --no-git-tag-version --allow-same-version",
    "changeset:publish": "changeset publish",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.3.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "highlight.js": "11.12.0",
    "husky": "^9.1.7",
    "katex": "0.19.0",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "playwright-core": "1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
