{
  "name": "pi-agent",
  "displayName": "Pi Agent",
  "description": "Chat with Pi in VS Code, ask about selected code, and apply focused modifications.",
  "version": "0.0.1",
  "publisher": "narumi",
  "license": "MIT",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/narumiruna/pi-vscode.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "pi",
    "coding agent",
    "ai",
    "code review",
    "refactor",
    "autocomplete",
    "inline completion",
    "agent",
    "chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "piCodingAgent",
          "title": "Pi",
          "icon": "resources/pi.svg"
        }
      ]
    },
    "views": {
      "piCodingAgent": [
        {
          "id": "piCodingAgent.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/pi.svg"
        }
      ]
    },
    "commands": [
      { "command": "piCodingAgent.repairFailedTest", "title": "Repair Failed Test (Preview)", "category": "Pi", "enablement": "isWorkspaceTrusted" },
      { "command": "piCodingAgent.askDebugContext", "title": "Ask Debug Context", "category": "Pi", "enablement": "isWorkspaceTrusted && debugState == stopped" },
      { "command": "piCodingAgent.reviewStagedChanges", "title": "Review Staged Changes", "category": "Pi", "enablement": "isWorkspaceTrusted" },
      { "command": "piCodingAgent.showStagedFindings", "title": "Show Staged Findings", "category": "Pi", "enablement": "isWorkspaceTrusted" },
      {
        "command": "piCodingAgent.openChat",
        "title": "Open Chat",
        "category": "Pi",
        "icon": "resources/pi.svg"
      },
      {
        "command": "piCodingAgent.askSelection",
        "title": "Ask About Selection",
        "category": "Pi",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "piCodingAgent.modifySelection",
        "title": "Modify Selection (Preview)",
        "category": "Pi",
        "icon": "$(wand)"
      },
      {
        "command": "piCodingAgent.inlineEdit",
        "title": "Inline Edit (Preview)",
        "category": "Pi",
        "icon": "$(edit)"
      },
      {
        "command": "piCodingAgent.quickFix",
        "title": "Quick Fix with Pi (Preview)",
        "category": "Pi",
        "icon": "$(lightbulb-sparkle)"
      },
      {
        "command": "piCodingAgent.explainSelection",
        "title": "Explain Selection",
        "category": "Pi",
        "icon": "$(info)"
      },
      {
        "command": "piCodingAgent.fixSelection",
        "title": "Fix Selection (Preview)",
        "category": "Pi",
        "icon": "$(wrench)"
      },
      {
        "command": "piCodingAgent.reviewSelection",
        "title": "Review Selection",
        "category": "Pi",
        "icon": "$(eye)"
      },
      {
        "command": "piCodingAgent.documentSelection",
        "title": "Document Selection (Preview)",
        "category": "Pi",
        "icon": "$(book)"
      },
      {
        "command": "piCodingAgent.generateTests",
        "title": "Generate Tests (Preview)",
        "category": "Pi",
        "icon": "$(beaker)"
      },
      {
        "command": "piCodingAgent.triggerInlineCompletion",
        "title": "Trigger Inline Completion",
        "category": "Pi",
        "icon": "$(sparkle)"
      },
      {
        "command": "piCodingAgent.suggestNextEdit",
        "title": "Suggest Next Edit (Preview)",
        "category": "Pi",
        "icon": "$(lightbulb-sparkle)"
      }
    ],
    "chatParticipants": [
      {
        "id": "piCodingAgent.chat",
        "name": "pi",
        "fullName": "Pi Agent",
        "description": "Ask Pi about code and programming tasks using your local Pi configuration.",
        "isSticky": true,
        "commands": [
          {
            "name": "explain",
            "description": "Explain code or a programming concept"
          },
          {
            "name": "review",
            "description": "Review code for bugs and improvements"
          },
          {
            "name": "fix",
            "description": "Suggest a fix for a problem"
          }
        ]
      }
    ],
    "submenus": [
      {
        "id": "piCodingAgent.selectionMenu",
        "label": "Pi"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "piCodingAgent.quickFix",
          "group": "navigation@40",
          "when": "!editorReadonly"
        },
        {
          "command": "piCodingAgent.openChat",
          "group": "navigation@50"
        }
      ],
      "editor/context": [
        {
          "command": "piCodingAgent.quickFix",
          "group": "1_modification@40",
          "when": "!editorReadonly"
        },
        {
          "submenu": "piCodingAgent.selectionMenu",
          "group": "1_modification@50",
          "when": "editorHasSelection"
        }
      ],
      "piCodingAgent.selectionMenu": [
        {
          "command": "piCodingAgent.askSelection",
          "group": "1_query@10"
        },
        {
          "command": "piCodingAgent.modifySelection",
          "group": "1_query@20"
        },
        {
          "command": "piCodingAgent.explainSelection",
          "group": "2_actions@10"
        },
        {
          "command": "piCodingAgent.fixSelection",
          "group": "2_actions@20"
        },
        {
          "command": "piCodingAgent.reviewSelection",
          "group": "2_actions@30"
        },
        {
          "command": "piCodingAgent.documentSelection",
          "group": "2_actions@40"
        },
        {
          "command": "piCodingAgent.generateTests",
          "group": "2_actions@50"
        }
      ]
    },
    "keybindings": [
      {
        "command": "piCodingAgent.quickFix",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && !suggestWidgetVisible"
      },
      {
        "command": "piCodingAgent.triggerInlineCompletion",
        "key": "alt+]",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "piCodingAgent.suggestNextEdit",
        "key": "ctrl+alt+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && !editorReadonly"
      }
    ],
    "configuration": {
      "title": "Pi Agent",
      "properties": {
        "piCodingAgent.sensitiveContextNames": {
          "type": "array", "items": { "type": "string" }, "default": [".env", "credential", "secret", "id_rsa", "id_ed25519"],
          "description": "Best-effort warnings for attachment labels containing these names. Inspect/redact before transmission."
        },
        "piCodingAgent.inlineCompletions.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Request automatic Pi inline completions after a typing pause. Disabled by default to avoid unexpected model usage; manual trigger remains available."
        },
        "piCodingAgent.inlineCompletions.debounceMilliseconds": {
          "type": "number",
          "default": 650,
          "minimum": 100,
          "maximum": 5000,
          "description": "Delay before an automatic inline completion request."
        },
        "piCodingAgent.inlineCompletions.minimumPrefixLength": {
          "type": "number",
          "default": 3,
          "minimum": 0,
          "maximum": 100,
          "description": "Minimum non-whitespace characters on the current line before automatic completion."
        },
        "piCodingAgent.inlineCompletions.excludedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "plaintext",
            "scminput"
          ],
          "description": "Language IDs excluded from Pi inline completions."
        },
        "piCodingAgent.agent.confirmToolCalls": {
          "type": "string",
          "default": "dangerous",
          "enum": [
            "off",
            "dangerous",
            "all"
          ],
          "enumDescriptions": [
            "Do not ask for per-tool approval for Pi's built-in mutating tools.",
            "Confirm dangerous shell commands and writes to sensitive or out-of-workspace paths.",
            "Confirm every bash, edit, and write tool call."
          ],
          "description": "Per-tool confirmation policy for built-in mutating tools in foreground and background Pi sessions. Tools contributed by Pi extensions manage their own permissions."
        },
        "piCodingAgent.approveProjectResources": {
          "type": "boolean",
          "default": false,
          "description": "Trust and load project-local Pi settings, extensions, skills, and prompts for RPC sessions. Enable only for workspaces you trust."
        },
        "piCodingAgent.executablePath": {
          "type": "string",
          "default": "pi",
          "description": "Path or command used to start the Pi CLI."
        },
        "piCodingAgent.provider": {
          "type": "string",
          "default": "",
          "description": "Optional Pi provider override. Leave empty to use Pi settings."
        },
        "piCodingAgent.model": {
          "type": "string",
          "default": "",
          "description": "Optional Pi model override. Leave empty to use Pi settings."
        },
        "piCodingAgent.thinkingLevel": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "off",
            "minimal",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "description": "Pi thinking-level override."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && vitest run",
    "package": "npm run test && vsce package --out pi-agent.vsix",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.106.0",
    "@vscode/vsce": "^3.6.2",
    "husky": "^9.1.7",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
